# Copy this file to ".env" (same folder as docker-compose.yml) and fill in real values.
# ".env" itself should never be committed to Git.

# PostgreSQL password (you choose this yourself, any value is fine for local use)
POSTGRES_PASSWORD=changeme

# JWT signing secret - generate with: openssl rand -base64 64
JWT_SECRET=

# Mailtrap sandbox credentials (create a free account at https://mailtrap.io,
# then go to Email Testing > Inboxes > your inbox > SMTP Settings > "Nodemailer"
# to find these two values)
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
